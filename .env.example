# Used at runtime by the app (can be a pooled/pgbouncer URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/berp_js?schema=public"

# Used by Prisma Migrate (must be a direct connection — pgbouncer blocks shadow DB creation)
# If you're not using pgbouncer, set this to the same value as DATABASE_URL
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/berp_js?schema=public"

NODE_ENV="development"
PORT=3000
