{
  "name": "berp-js-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bunx prisma generate && ([ -d .git ] && bunx lefthook install || true)",
    "dev": "bun --hot src/index.js",
    "build": "bun run build.js",
    "build:frontend": "bun run build.js",
    "start": "bun run src/index.js",
    "check": "bun run lint && bun run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prisma:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:fresh": "bun run db:reset && bun run db:seed",
    "db:reset": "bunx prisma migrate reset",
    "db:seed": "bun prisma/seed.js",
    "db:studio": "bunx prisma studio"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "latest",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "dotenv": "latest",
    "elysia": "latest",
    "elysia-helmet": "^3.1.0",
    "prisma": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "bun-plugin-tailwind": "latest",
    "lefthook": "^2.1.6",
    "tailwindcss": "latest"
  }
}
